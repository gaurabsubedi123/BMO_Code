# ---- Data: the annotated corpus is NOT distributed. Never commit it. ----
data/raw/*
!data/raw/.gitkeep
*.xlsx
*.csv
# Aggregate metric tables ARE committed. The negation must be recursive: an
# earlier "!results/*.csv" matched only the top level and silently excluded
# every file in results/<run>/ and results/<run>/per_tier/.
!results/**/*.csv
!results/*.csv
# ...except any file carrying record-level corpus content. hard_records_test.csv
# held NCTId + label + outcome text for the records most systems got wrong; that
# is the annotated corpus, which is not ours to release.
results/**/hard_records*.csv
*.xls

# ---- Generated outputs and trained models (regenerate via run_pipeline.sh) ----
outputs/
models/
demo/flagged/

# ---- Logs ----
*.log
pipeline_run.log

# ---- Drafts, abstracts, internal docs ----
*.docx
*.pdf
# ...but the manuscript figures are part of the release.
!figures/*.pdf
DOCUMENTATION.md

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.env

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
.ipynb_checkpoints/
note: results/*.csv are aggregate metrics and ARE committed (see docs/RESULTS.md)
